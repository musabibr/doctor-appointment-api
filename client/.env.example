# Only needed when the web app and the API are served from different origins
# (e.g. the API is deployed separately). Leave empty to use the Vite dev proxy.
VITE_API_URL=

# Currency used to display doctor prices (ISO 4217 code).
VITE_CURRENCY=USD

# Where the dev server forwards /api and /uploads (defaults to http://localhost:5000).
API_PROXY_TARGET=
