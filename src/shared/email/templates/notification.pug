extends baseEmail

block content
  p Hi #{firstName},
  each line in lines
    p= line
  if actionUrl
    table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
      tbody
        tr
          td(align='left')
            table(role='presentation', border='0', cellpadding='0', cellspacing='0')
              tbody
                tr
                  td
                    a(href=actionUrl, target='_blank')= actionLabel || 'Open'
  p - The #{appName} team
