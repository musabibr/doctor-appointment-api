extends baseEmail

block content
  p Hi #{firstName},
  p Welcome to #{appName}, we're glad to have you!
  if url
    table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
      tbody
        tr
          td(align='left')
            table(role='presentation', border='0', cellpadding='0', cellspacing='0')
              tbody
                tr
                  td
                    a(href=url, target='_blank') Open #{appName}
  p If you need any help, please don't hesitate to contact us!
  p - The #{appName} team
