# Copy this file to `.env` and adjust the values. Every variable is optional in
# development: the defaults below are what the API uses when one is missing.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Name used in emails and as the Cloudinary folder.
APP_NAME=Doctorri
# Origin(s) of the web app, comma separated. Used for CORS and for links in emails.
CLIENT_URL=http://localhost:5173
# Time zone of the clinics. Decides when a slot is "in the past". Defaults to the server's time zone.
# APP_TIMEZONE=Africa/Khartoum

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_appointment

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# REQUIRED in production: a long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# Requests per 15 minutes per IP: all API calls / failed logins, sign-ups and emails.
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
# Set to 1 when the API runs behind one reverse proxy (Render, Heroku, Nginx...).
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Email (optional). Without these, emails (verification codes, reset links...)
# are printed in the API terminal instead of being sent.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# File uploads (optional). Without Cloudinary, files are stored in ./uploads.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# Default admin for `npm run create-admin` (command-line options take priority).
# ---------------------------------------------------------------------------
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
