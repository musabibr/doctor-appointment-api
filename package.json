{
  "name": "doctor-appointment-api",
  "version": "1.0.0",
  "description": "Doctor appointment booking platform: Express + MongoDB modular-monolith API with a React 19 web client.",
  "main": "server.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:client": "npm --prefix client run dev",
    "dev:all": "node scripts/dev-all.js",
    "setup": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musabibr/doctor-appointment-api.git"
  },
  "author": "musab ibrahim",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/musabibr/doctor-appointment-api/issues"
  },
  "homepage": "https://github.com/musabibr/doctor-appointment-api#readme",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "mongoose": "^8.24.5",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pug": "^3.0.3",
    "validator": "^13.12.0",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
